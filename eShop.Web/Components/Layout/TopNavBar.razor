@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<nav class="navbar navbar-expand-lg navbar-dark eshop-navbar sticky-top">
    <div class="container-fluid px-3">
        <a class="eshop-brand" href="">
            <span class="brand-icon">⚡</span>
            <span>eShop</span>
        </a>

        <div class="navbar-nav me-auto ms-4 align-items-center d-none d-lg-flex">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Store</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink class="nav-link" href="outstandingorders">Outstanding Orders</NavLink>
                    <NavLink class="nav-link" href="processedorders">Processed Orders</NavLink>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="navbar-nav ms-auto align-items-center flex-row gap-2">
            <AuthorizeView>
                <Authorized>
                    <a class="nav-link text-white small" href="logout">Sign Out</a>
                </Authorized>
                <NotAuthorized>
                    <NavLink class="nav-link text-white small" href="login">Login</NavLink>
                </NotAuthorized>
            </AuthorizeView>
            <div>
                <eShop.Web.CustomerPortal.Controls.CartComponent @rendermode="InteractiveServer" />
            </div>
        </div>
    </div>
</nav>
