@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<div class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
    <ul class="navbar-nav me-auto align-items-center">
        <li class="nav-item">
            <a class="navbar-brand" href="">eShop</a>
        </li>
        <AuthorizeView>
            <Authorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="outstandingorders">Outstanding Orders</NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="processedorders">Processed Orders</NavLink>
                </li>
            </Authorized>
        </AuthorizeView>
    </ul>
    <ul class="navbar-nav ms-auto align-items-center">
        <AuthorizeView>
            <Authorized>
                <li class="nav-item">
                    <a class="nav-link text-white" href="logout">Sign Out</a>
                </li>
            </Authorized>
            <NotAuthorized>
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="login">Login</NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
        <li class="nav-item ms-2">
            <eShop.Web.CustomerPortal.Controls.CartComponent />
        </li>
    </ul>
</div>

