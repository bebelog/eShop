@using eShop.CoreBusiness.Models
@inject NavigationManager navigationManager

<div class="order-summary-box">
    <h5 class="order-summary-title">Order Summary</h5>
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Items (@itemsCount):</span>
        <span class="fw-semibold">@itemsTotalPrice.ToString("c")</span>
    </div>
    <div class="d-flex justify-content-between mb-2">
        <span class="text-muted">Shipping & Handling:</span>
        <span class="fw-semibold text-success">Free</span>
    </div>
    <div class="d-flex justify-content-between mb-3">
        <span class="text-muted">Estimated Tax:</span>
        <span class="fw-semibold">$0.00</span>
    </div>
    <div class="d-flex justify-content-between order-total-row">
        <span>Order Total:</span>
        <span>@itemsTotalPrice.ToString("c")</span>
    </div>

    @if (!HidePlaceOrderButton && !HidePlaceOrder)
    {
        <button class="btn btn-primary w-100 mt-4 py-2" @onclick="PlaceOrder">
            Proceed to Checkout
        </button>
    }
</div>

@code {
    int itemsCount = 0;
    double itemsTotalPrice = 0;

    [Parameter]
    public Order? order { get; set; }

    [Parameter]
    public bool HidePlaceOrderButton { get; set; } = false;

    [Parameter]
    public bool HidePlaceOrder { get; set; } = false;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (order != null && order.LineItems != null)
        {
            itemsCount = order.LineItems.Count;
            itemsTotalPrice = 0;
            order.LineItems.ForEach(x => itemsTotalPrice += x.Price * x.Quantity);
        }
    }

    private void PlaceOrder()
    {
        navigationManager.NavigateTo("/placeorder");
    }
}
