@using eShop.CoreBusiness.Models
@using eShop.UseCases.ShoppingCartScreen.interfaces
@inject IDeleteProductUseCase deleteProductUseCase
@inject IUpdateQuantityUseCase updateQuantityUseCase

@if (LineItem != null && LineItem.Product != null)
{
    <div class="cart-item-card">
        <div class="row align-items-center">
            <div class="col-auto">
                <img src="@LineItem.Product.ImageLink" alt="@LineItem.Product.Name" class="cart-item-img" />
            </div>
            <div class="col">
                <h6 class="fw-bold mb-1">@LineItem.Product.Name</h6>
                <div class="text-muted small mb-2">@LineItem.Product.Brand</div>
                <div class="d-flex align-items-center gap-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="small text-muted">Qty:</span>
                        <input type="number" min="0" value="@LineItem.Quantity" @onchange="HandleQuantityChange" class="form-control form-control-sm text-center" style="width: 70px;" />
                    </div>
                    <div class="fw-bold text-primary">
                        @LineItem.Product.Price.ToString("c")
                    </div>
                </div>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-danger btn-sm" @onclick="@(() => DeleteProduct(LineItem.ProductId))" title="Remove item">
                    Delete
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public OrderLineItem LineItem { get; set; } = null!;

    private async Task HandleQuantityChange(ChangeEventArgs e)
    {
        if (e.Value == null || string.IsNullOrWhiteSpace(e.Value.ToString())) return;

        if (int.TryParse(e.Value.ToString(), out int qty))
        {
            if (qty < 0) return;
            if (qty == 0)
            {
                await deleteProductUseCase.Execute(LineItem.ProductId);
            }
            else
            {
                await updateQuantityUseCase.Execute(LineItem.ProductId, qty);
            }
        }
    }

    private async Task DeleteProduct(int productId)
    {
        await deleteProductUseCase.Execute(productId);
    }
}
