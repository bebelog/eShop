@page "/"
@page "/products"
@rendermode InteractiveServer
@inject ISearchProductUseCase searchProduct

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="page-heading mb-1">Featured Products</h2>
        <p class="text-muted small">Explore our premium catalog with high performance and quality.</p>
    </div>
</div>

<SearchBarComponent OnSearch="HandleSearch" />

@if (products != null && products.Any())
{
    <div class="row">
        @foreach (var product in products)
        {
            <ProductCardComponent product="product" />
        }
    </div>
}
else
{
    <div class="alert alert-light border text-center py-5">
        <p class="mb-0 text-muted">No products found matching your search criteria.</p>
    </div>
}

@code {
    private IEnumerable<Product>? products;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        products = searchProduct.Execute();
    }

    private void HandleSearch(string filter)
    {
        products = searchProduct.Execute(filter);
    }
}
