@page "/cart"
@rendermode InteractiveServer
@using eShop.CoreBusiness.Models
@using eShop.UseCases.PluginInterfaces.StateStore
@using eShop.UseCases.ShoppingCartScreen.interfaces
@implements IDisposable

@inject IViewShoppingCartUseCase viewShoppingCartUseCase
@inject IShoppingCartStateStore shoppingCartStateStore

<h2 class="page-heading">Shopping Cart</h2>

@if (order != null && order.LineItems != null && order.LineItems.Count > 0)
{
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            @for (int i = 0; i < order.LineItems.Count; i++)
            {
                <LineItemComponent LineItem="order.LineItems[i]" />
            }
        </div>
        <div class="col-12 col-lg-4">
            <OrderSummaryComponent order="order" />
        </div>
    </div>
}
else
{
    <div class="alert alert-light border text-center py-5">
        <h5 class="fw-bold mb-2">Giỏ hàng của bạn đang trống.</h5>
        <p class="text-muted small mb-3">Hãy dạo quanh cửa hàng và chọn các sản phẩm ưng ý nhé!</p>
        <a href="" class="btn btn-primary btn-sm">Tiếp tục mua hàng</a>
    </div>
}

@code {
    private Order? order;

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if(firstRender){
            shoppingCartStateStore.AddStateChangeListeners(HandleShoppingCartStateChange);
            order = await viewShoppingCartUseCase.Execute();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleShoppingCartStateChange()
    {
        order = await viewShoppingCartUseCase.Execute();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        shoppingCartStateStore.RemoveStateChangeListeners(HandleShoppingCartStateChange);
    }
}
