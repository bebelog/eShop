@page "/product/{id:int}"
@rendermode InteractiveServer

@inject NavigationManager naviationManager
@inject IViewProductUseCase viewProduct
@inject IAddProductToCartUseCase addProductToCartUseCase

<div class="mb-3">
    <NavLink href="" class="text-muted text-decoration-none small">← Back to Products</NavLink>
</div>

@if (product != null)
{
    <div class="eshop-card p-4 p-md-5">
        <div class="row g-5 align-items-center">
            <div class="col-12 col-md-5 text-center">
                <div class="p-3 bg-white rounded-3">
                    <img src="@product.ImageLink" alt="@product.Name" class="img-fluid" style="max-height: 320px; object-fit: contain;" />
                </div>
            </div>
            <div class="col-12 col-md-7">
                <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-2 rounded-pill fw-semibold">@product.Brand</span>
                <h2 class="fw-bold mb-3">@product.Name</h2>
                <div class="mb-3">
                    <span class="fs-2 fw-bold text-primary">@product.Price.ToString("c")</span>
                </div>
                <hr class="my-4" />
                <h6 class="fw-bold text-muted text-uppercase small mb-2">Description</h6>
                <p class="text-secondary leading-relaxed mb-4">@product.Description</p>
                <button class="btn btn-primary btn-lg px-4 py-2" @onclick="AddToCart">
                    🛒 Add to Cart
                </button>
            </div>
        </div>
    </div>
}

@code {
    private Product? product;

    [Parameter]
    public int Id { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Id > 0)
            product = viewProduct.Execute(Id);
    }

    private void AddToCart()
    {
        if (product != null)
        {
            addProductToCartUseCase.Execute(product.ProductId);
            naviationManager.NavigateTo("/");
        }
    }
}
