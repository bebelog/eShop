@page "/orderdetail/{Id:int}"
@page "/processedorder/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]

@using eShop.CoreBusiness.Models
@using eShop.UseCases.AdminPortal.OrderDetailScreen
@using Microsoft.AspNetCore.Components

@inject IViewOrderDetailUseCase ViewOrderDetailUseCase
@inject IProcessOrderUseCase ProcessOrderUseCase
@inject NavigationManager NavigationManager

<h3>Order Detail</h3>
<br />

@if (order != null)
{
    <p><b>Customer Info:</b></p>
    <p>@order.CustomerName</p>
    <p>@order.CustomerAddress</p>
    <p>@order.CustomerCity</p>
    <p>@order.CustomerStateProvince</p>
    <p>@order.CustomerCountry</p>

    <br />

    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Price</th>
                <th>Quantity</th>
            </tr>
        </thead>
        <tbody>
            @if (order.LineItems != null)
            {
                @foreach (var item in order.LineItems)
                {
                    <tr>
                        <td>@(item.Product?.Name ?? $"Product #{item.ProductId}")</td>
                        <td>@(item.Product?.Price.ToString("c") ?? item.Price.ToString("c"))</td>
                        <td>@item.Quantity</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <br />
    @if (!order.DateProcessed.HasValue)
    {
        <button type="button" class="btn btn-primary" @onclick="HandleProcessOrder">Mark Order as Processed</button>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Order? order;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Id > 0)
        {
            order = ViewOrderDetailUseCase.Execute(Id);
        }
    }

    private void HandleProcessOrder()
    {
        if (order != null && order.OrderId.HasValue)
        {
            ProcessOrderUseCase.Execute(order.OrderId.Value, "admin");
            NavigationManager.NavigateTo("outstandingorders");
        }
    }
}
