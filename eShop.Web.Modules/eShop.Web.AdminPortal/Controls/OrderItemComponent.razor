@using eShop.CoreBusiness.Models
@using Microsoft.AspNetCore.Components.Routing

@if (Order != null)
{
    <tr>
        <td>
            @if (Order.DatePlaced.HasValue)
            {
                @Order.DatePlaced.Value.ToString("yyyy-MM-dd")
            }
        </td>
        <td>
            @if (Order.DateProcessed.HasValue)
            {
                <NavLink href="@($"/processedorder/{Order.OrderId}")">@Order.OrderId</NavLink>
            }
            else
            {
                <NavLink href="@($"/orderdetail/{Order.OrderId}")">@Order.OrderId</NavLink>
            }
        </td>
        <td>@Order.CustomerCountry</td>
        <td>@Order.CustomerStateProvince</td>
        <td>@Order.CustomerCity</td>
        <td>@Order.CustomerName</td>
    </tr>
}

@code {
    [Parameter]
    public Order? Order { get; set; }
}
