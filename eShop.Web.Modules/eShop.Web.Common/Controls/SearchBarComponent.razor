<div class="search-container">
    <div class="search-input-group">
        <input type="text" class="form-control" @bind-value="filter" placeholder="Search products by name or brand..." @onkeydown="HandleKeyDown" />
        <button type="button" class="btn btn-primary" @onclick="HandleSearch">Search</button>
    </div>
</div>

@code {
    private string filter = string.Empty;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private void HandleSearch()
    {
        OnSearch.InvokeAsync(filter);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSearch();
        }
    }
}
